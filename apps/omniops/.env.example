# Standalone demo mode works without a running RAGFlow instance.
OMNIOPS_MODE=demo
OMNIOPS_HOST=127.0.0.1
OMNIOPS_PORT=8090
OMNIOPS_ENABLE_DEMO_SEED=1
OMNIOPS_MAX_UPLOAD_MB=8

# Switch to ragflow only after Gate 1 runtime is verified.
# OMNIOPS_MODE=ragflow
# OMNIOPS_RAGFLOW_API_ROOT=http://127.0.0.1:9380/api/v1
# OMNIOPS_RAGFLOW_API_KEY=replace_locally
# OMNIOPS_RAGFLOW_CHAT_ID=replace_locally
