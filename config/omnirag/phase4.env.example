# All Phase-4 behavior is OFF by default so the frozen RAGFlow baseline remains reproducible.
OMNIRAG_AGENT_GOVERNANCE=0
OMNIRAG_AGENT_MEMORY=0
OMNIRAG_AGENT_MEMORY_WRITE=0
OMNIRAG_AGENT_ALLOW_SEMANTIC_MEMORY_WRITE=0

# Optional bounded override. The runtime clamps this to 0..3.
OMNIRAG_AGENT_RETRY_BUDGET=2

# RAGFlow memory-query parameters. These configure RAGFlow's search; OmniRAG
# does not pretend the returned rows include a raw similarity score.
OMNIRAG_AGENT_MEMORY_SIMILARITY_THRESHOLD=0.15
OMNIRAG_AGENT_MEMORY_KEYWORD_WEIGHT=0.7
