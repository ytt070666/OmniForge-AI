# Phase 5 is opt-in. Leave disabled for a byte-for-byte native Agent tool path.
OMNIRAG_TOOL_GOVERNANCE=0

# Conservative default: read-only tools only.
OMNIRAG_TOOL_ALLOWED_RISKS=read
OMNIRAG_TOOL_ALLOW_DESTRUCTIVE=0
OMNIRAG_TOOL_ALLOW_OPEN_WORLD=0

# Per-query model-visible shortlist and execution budgets.
OMNIRAG_TOOL_MAX_VISIBLE=6
OMNIRAG_TOOL_MAX_CALLS=8
OMNIRAG_TOOL_MAX_CALLS_PER_TOOL=3
OMNIRAG_TOOL_SELECTOR_MIN_SCORE=0.05
OMNIRAG_TOOL_SAFE_FALLBACK=4
