{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmniRAG advisory control router output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_class",
    "retrieval_profile",
    "needs_visual",
    "needs_tools",
    "tool_intent",
    "evidence_strictness"
  ],
  "properties": {
    "query_class": {
      "type": "string",
      "enum": ["lexical_precision", "semantic", "hybrid", "crosslingual", "visual", "tool"]
    },
    "retrieval_profile": {
      "type": "string",
      "enum": ["sparse_heavy", "balanced", "dense_heavy"]
    },
    "needs_visual": {"type": "boolean"},
    "needs_tools": {"type": "boolean"},
    "tool_intent": {
      "type": "string",
      "enum": ["none", "knowledge_search", "weather", "device_lookup", "runbook_search", "availability_calc"]
    },
    "evidence_strictness": {
      "type": "string",
      "enum": ["normal", "high"]
    }
  }
}
