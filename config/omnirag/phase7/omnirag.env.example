# No secrets belong in this file. Put secrets in docker/.env or a secret manager.
RAGFLOW_BASE_IMAGE=infiniflow/ragflow:v0.27.2
OMNIRAG_IMAGE=omnirag-agent:phase7

# All feature switches default off so the original baseline remains reproducible.
OMNIRAG_ADAPTIVE_RETRIEVAL=0
OMNIRAG_MULTIMODAL=0
OMNIRAG_AGENT_GOVERNANCE=0
OMNIRAG_TOOL_GOVERNANCE=0

# Phase 4 bounded governance.
OMNIRAG_AGENT_MAX_RETRIES=1

# Phase 5 fail-closed tool policy.
OMNIRAG_TOOL_ALLOWED_RISKS=read
OMNIRAG_TOOL_ALLOW_DESTRUCTIVE=0
OMNIRAG_TOOL_ALLOW_OPEN_WORLD=0

# Observability must not contain raw prompts/tool arguments by default.
OMNIRAG_OBSERVABILITY_RAW_TEXT=0
